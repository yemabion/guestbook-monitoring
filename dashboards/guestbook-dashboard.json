{
 "title": "Guestbook Monitoring",
 "uid": "guestbook-monitoring",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "ds",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Redis up (1 = healthy)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "redis_up",
     "legendFormat": "{{job}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Guestbook operations per second (writes on leader, reads on replica)",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 9,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(redis_commands_total{cmd=\"set\", service=\"redis-leader\"}[1m]))",
     "legendFormat": "writes (leader set)"
    },
    {
     "refId": "B",
     "expr": "sum(rate(redis_commands_total{cmd=\"get\", service=\"redis-replica\"}[1m]))",
     "legendFormat": "reads (replica get)"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Redis connected clients",
   "gridPos": {
    "x": 15,
    "y": 0,
    "w": 9,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job) (redis_connected_clients)",
     "legendFormat": "{{job}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Redis memory used",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job) (redis_memory_used_bytes)",
     "legendFormat": "{{job}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Frontend CPU (cores, per pod)",
   "gridPos": {
    "x": 8,
    "y": 6,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"default\",pod=~\"frontend.*\",container=\"frontend\"}[5m]))",
     "legendFormat": "{{pod}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Frontend memory (per pod)",
   "gridPos": {
    "x": 16,
    "y": 6,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"default\",pod=~\"frontend.*\",container=\"frontend\"})",
     "legendFormat": "{{pod}}"
    }
   ]
  }
 ]
}